<%- include('../layouts/header') %>

<div class="card">
  <div class="card-title">
    <h2>📅 Danh sách Hoạt động & Sự kiện CLB</h2>
  </div>
  <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
    Tổng hợp các buổi workshop, hội thảo khoa học, teambuilding và các hoạt động chuyên môn của Câu lạc bộ.
  </p>

  <% if (events && events.length > 0) { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;">
      <% events.forEach(e => { %>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; display: flex; flex-direction: column; background: #fff;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
            <span class="badge <%= e.status === 'published' ? 'badge-published' : 'badge-completed' %>">
              <%= e.status === 'published' ? 'Đang mở đăng ký' : 'Đã kết thúc' %>
            </span>
            <small style="color: var(--text-muted); font-size: 0.8rem;">Sức chứa: <%= e.capacity %> người</small>
          </div>

          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; line-height: 1.3;">
            <a href="/events/<%= e.id %>" style="color: var(--text-main); text-decoration: none;"><%= e.title %></a>
          </h3>

          <p style="font-size: 0.85rem; color: var(--text-muted); flex: 1; margin-bottom: 1rem;">
            <%= e.description ? e.description.substring(0, 110) + '...' : 'Không có mô tả chi tiết.' %>
          </p>

          <div style="font-size: 0.85rem; border-top: 1px solid #f1f5f9; padding-top: 0.75rem; margin-bottom: 1rem;">
            <div style="margin-bottom: 0.25rem;">📍 <strong>Địa điểm:</strong> <%= e.location %></div>
            <div style="margin-bottom: 0.25rem;">⏰ <strong>Bắt đầu:</strong> <%= new Date(e.start_at).toLocaleString('vi-VN') %></div>
            <div>👥 <strong>Đã đăng ký:</strong> <%= e.registered_count %> / <%= e.capacity %></div>
          </div>

          <a href="/events/<%= e.id %>" class="btn btn-outline" style="width: 100%; text-align: center;">Xem chi tiết & Đăng ký</a>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p style="color: var(--text-muted); text-align: center; padding: 2rem;">Chưa có sự kiện nào được công bố.</p>
  <% } %>
</div>

<%- include('../layouts/footer') %>
