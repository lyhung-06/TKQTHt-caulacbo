<%- include('../layouts/header') %>

<div style="max-width: 440px; margin: 2rem auto;">
  <div class="card" style="padding: 2.25rem 2rem;">
    <h2 style="text-align: center; margin-bottom: 0.5rem;">Đăng nhập Hệ thống</h2>
    <p style="text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
      Quản lý Câu lạc bộ Tin học & Kỹ thuật Phần mềm
    </p>

    <% if (error) { %>
      <div class="alert alert-error" style="font-size: 0.85rem;"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success" style="font-size: 0.85rem;"><%= success %></div>
    <% } %>

    <form action="/auth/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label">Tên đăng nhập hoặc Email:</label>
        <input type="text" name="username" class="form-control" placeholder="Nhập username hoặc email" required autofocus>
      </div>

      <div class="form-group">
        <label class="form-label">Mật khẩu:</label>
        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; padding: 0.65rem;">
        Đăng nhập
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.875rem; color: var(--text-muted);">
      Chưa có tài khoản? <a href="/auth/register" style="color: var(--primary); text-decoration: none; font-weight: 600;">Đăng ký ngay</a>
    </div>

    <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--border); font-size: 0.8rem; color: var(--text-muted); line-height: 1.6;">
      <strong>Tài khoản thử nghiệm:</strong> admin, officer1 và member1.<br>
      Mật khẩu khởi tạo được cấu hình riêng trong tệp <code>.env</code> của môi trường triển khai.
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
