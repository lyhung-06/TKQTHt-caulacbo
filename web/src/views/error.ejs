<%- include('layouts/header') %>

<div class="card" style="max-width: 600px; margin: 3rem auto; text-align: center; padding: 2.5rem 1.5rem;">
  <div style="font-size: 3rem; margin-bottom: 1rem;">
    <% if (status === 403) { %> 🚫 <% } else if (status === 404) { %> 🔍 <% } else { %> ⚠️ <% } %>
  </div>
  <h2 style="margin-bottom: 0.75rem;"><%= title %></h2>
  <p style="color: var(--text-muted); margin-bottom: 1.5rem;"><%= message %></p>
  <div>
    <a href="/" class="btn btn-primary">Về Trang chủ</a>
    <a href="javascript:history.back()" class="btn btn-outline" style="margin-left: 0.5rem;">Quay lại</a>
  </div>
</div>

<%- include('layouts/footer') %>
