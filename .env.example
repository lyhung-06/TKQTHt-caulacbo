# ==============================================================================
# CLUB MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
NODE_ENV=production
PORT=3000

# Database Configuration (MySQL 8)
DB_HOST=db
DB_PORT=3306
DB_NAME=club_management
DB_USER=club_user
DB_PASSWORD=replace_with_32_or_more_random_letters_numbers_underscores_or_hyphens
DB_ROOT_PASSWORD=replace_with_32_or_more_random_letters_numbers_underscores_or_hyphens
DB_MONITOR_USER=club_monitor
DB_MONITOR_PASSWORD=replace_with_32_or_more_random_letters_numbers_underscores_or_hyphens

# Application Security
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
ADMIN_INITIAL_PASSWORD=replace_with_a_unique_strong_admin_password
OFFICER_INITIAL_PASSWORD=replace_with_a_unique_strong_officer_password
MEMBER_INITIAL_PASSWORD=replace_with_a_unique_strong_member_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_unique_strong_grafana_password

# Ports Mapping (Non-conflicting defaults)
GRAFANA_DOMAIN=localhost
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
HOST_PROMETHEUS_PORT=9091
